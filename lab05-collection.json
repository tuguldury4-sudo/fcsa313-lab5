{
  "info": {
    "name": "Lab 5 Registration API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    }
  ],
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Set up student",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/students/lab05-student-1",
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS201\"]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"result is OK\", () => pm.expect(pm.response.json().result).to.eql(\"OK\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Set up course",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/courses/lab05-course-1",
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[\"CS201\"]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"result is OK\", () => pm.expect(pm.response.json().result).to.eql(\"OK\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Happy path: OK",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/registrations",
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"lab05-student-1\",\"courseID\":\"lab05-course-1\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"result is OK\", () => pm.expect(pm.response.json().result).to.eql(\"OK\"));",
                  "pm.test(\"Registration ID is a positive integer\", () => pm.expect(Number.isInteger(pm.response.json().registrationID) && pm.response.json().registrationID > 0).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
